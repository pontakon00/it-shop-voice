# ─────────────────────────────────────────────────────────────
# ShopVoice — ตัวอย่างค่าตั้งค่า
#
# คัดลอกเป็น .env.local แล้วแก้ค่าตามที่ใช้จริง
#   cp .env.example .env.local
#
# ระบบรันได้ครบทุกอย่างแม้ไม่ตั้งค่าใดเลย
# (ไม่มี DATABASE_URL → ใช้ src/data/products.json)
# (ไม่มี N8N_WEBHOOK_URL → ไม่มี AI Fallback)
# ─────────────────────────────────────────────────────────────

# ── ฐานข้อมูล MySQL ──────────────────────────────────────────
# เริ่มด้วย:  docker compose up -d
# ค่านี้ตรงกับ docker-compose.yml
DATABASE_URL="mysql://shopvoice:shopvoice@localhost:3306/shopvoice"

# ── n8n (AI Fallback) ────────────────────────────────────────
# 1. ติดตั้ง n8n:  npm install -g n8n && n8n
# 2. import ไฟล์ n8n/shopvoice-workflow.json เข้า n8n แล้วกด Activate
# 3. ใส่ค่านี้ (URL production จะได้หลังกด Activate)
N8N_WEBHOOK_URL="http://localhost:5678/webhook/shopvoice-ask"

# เวลารอสูงสุดที่รอ n8n ตอบ (มิลลิวินาที) ค่าเริ่มต้น 8000
N8N_TIMEOUT_MS="8000"

# ── Groq AI ──────────────────────────────────────────────────
# ไม่ต้องใส่ในเว็บนี้! คีย์ถูกเรียกจาก n8n เท่านั้น
# ตั้งในไฟล์ .env ของ n8n แทน:
#   Windows  %USERPROFILE%\.n8n\.env
#   macOS/Linux  ~/.n8n/.env
#
#   GROQ_API_KEY=gsk_xxxxxxxx
#   N8N_BLOCK_ENV_ACCESS_IN_NODE=false
#
# ขอคีย์ฟรีที่ https://console.groq.com/keys
